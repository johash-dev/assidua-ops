{
  "name": "assidua-ops",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter api --filter web --parallel dev",
    "lint": "pnpm --filter api lint && pnpm --filter web lint",
    "typecheck": "pnpm --filter api typecheck && pnpm --filter web typecheck",
    "test": "pnpm --filter api test",
    "test:e2e": "playwright test",
    "db:migrate": "dotenv -e .env -- pnpm --filter api run prisma:migrate",
    "db:generate": "pnpm --filter api exec prisma generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "dotenv-cli": "^8.0.0"
  }
}
