generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id             String         @id @default(cuid())
  name           String
  active         Boolean        @default(true)
  defaultSlaDays Int            @default(10)
  categories     CategoryNode[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model CategoryNode {
  id           String         @id @default(cuid())
  name         String
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id])
  parentId     String?
  parent       CategoryNode?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     CategoryNode[] @relation("CategoryTree")
  isLeaf       Boolean
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([departmentId])
  @@index([parentId])
}
