generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  FRONT_DESK
  COORDINATOR
  DEPARTMENT_HEAD
  ADMIN
}

model Department {
  id             String         @id @default(cuid())
  name           String
  active         Boolean        @default(true)
  defaultSlaDays Int            @default(10)
  categories     CategoryNode[]
  staffUsers     StaffUser[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model CategoryNode {
  id           String         @id @default(cuid())
  name         String
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id])
  parentId     String?
  parent       CategoryNode?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     CategoryNode[] @relation("CategoryTree")
  isLeaf       Boolean
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([departmentId])
  @@index([parentId])
}

model StaffUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  role         StaffRole
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id])
  active       Boolean        @default(true)
  passwordHash String
  sessions     StaffSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([departmentId])
}

model StaffSession {
  id          String    @id @default(cuid())
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([staffUserId])
}

model AuditEntry {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  actorUserId  String?
  action       String
  entityType   String
  entityId     String
  departmentId String?
  metadata     Json?

  @@index([departmentId, at])
}
